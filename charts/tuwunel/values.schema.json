{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "tuwunel",
  "description": "Values of the tuwunel chart. Only the keys that have a fixed type or range are described here; everything else is checked by the templates.",
  "type": "object",
  "properties": {
    "replicaCount": {
      "type": "integer",
      "enum": [0, 1]
    },
    "serverName": {
      "type": "string"
    },
    "config": {
      "type": ["object", "null"]
    },
    "extraConfigToml": {
      "type": "string"
    },
    "enableServiceLinks": {
      "type": "boolean"
    },
    "automountServiceAccountToken": {
      "type": "boolean"
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "image": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string"
        },
        "tag": {
          "type": "string"
        },
        "digest": {
          "type": "string"
        },
        "pullPolicy": {
          "type": "string",
          "enum": ["Always", "IfNotPresent", "Never"]
        }
      }
    },
    "persistence": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "existingClaim": {
          "type": "string"
        },
        "storageClass": {
          "type": "string"
        },
        "size": {
          "type": "string"
        },
        "accessModes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "media": {
      "type": "object",
      "properties": {
        "s3": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "providerName": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "endpoint": {
              "type": "string"
            },
            "bucket": {
              "type": "string"
            },
            "region": {
              "type": "string"
            },
            "basePath": {
              "type": "string"
            },
            "existingSecret": {
              "type": "string"
            },
            "accessKeyKey": {
              "type": "string"
            },
            "secretKeyKey": {
              "type": "string"
            }
          }
        }
      }
    },
    "service": {
      "type": "object",
      "properties": {
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "tls": {
          "type": "array"
        },
        "extraPaths": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "blockedPaths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "probes": {
      "type": "object",
      "properties": {
        "startup": {
          "type": "object",
          "properties": {
            "command": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "default": ["tuwunel", "--health-check"]
            },
            "periodSeconds": {
              "type": "integer"
            },
            "failureThreshold": {
              "type": "integer"
            },
            "timeoutSeconds": {
              "type": "integer"
            }
          }
        },
        "liveness": {
          "type": "object",
          "properties": {
            "command": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "default": ["tuwunel", "--health-check"]
            },
            "periodSeconds": {
              "type": "integer"
            },
            "failureThreshold": {
              "type": "integer"
            },
            "timeoutSeconds": {
              "type": "integer"
            }
          }
        },
        "readiness": {
          "type": "object",
          "properties": {
            "command": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "default": ["tuwunel", "--health-check"]
            },
            "periodSeconds": {
              "type": "integer"
            },
            "failureThreshold": {
              "type": "integer"
            },
            "timeoutSeconds": {
              "type": "integer"
            }
          }
        }
      }
    },
    "route": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "tls": {
          "type": "object",
          "properties": {
            "certificate": {
              "type": "object",
              "properties": {
                "issuer": {
                  "type": "string",
                  "default": "letsencrypt"
                }
              }
            }
          }
        }
      }
    },
    "import": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "image": {
          "type": "object",
          "properties": {
            "repository": {
              "type": "string"
            },
            "tag": {
              "type": "string"
            },
            "digest": {
              "type": "string"
            }
          }
        },
        "synapseDb": {
          "type": "object",
          "properties": {
            "existingSecret": {
              "type": "string"
            },
            "key": {
              "type": "string"
            }
          }
        },
        "signingKey": {
          "type": "object",
          "properties": {
            "existingSecret": {
              "type": "string"
            },
            "key": {
              "type": "string"
            }
          }
        },
        "media": {
          "type": "object",
          "properties": {
            "fromS3": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "endpoint": {
                  "type": "string"
                },
                "bucket": {
                  "type": "string"
                },
                "prefix": {
                  "type": "string"
                },
                "existingSecret": {
                  "type": "string"
                },
                "image": {
                  "type": "object",
                  "properties": {
                    "repository": {
                      "type": "string"
                    },
                    "tag": {
                      "type": "string"
                    }
                  }
                },
                "resources": {
                  "type": "object"
                }
              }
            },
            "emptyDirSizeLimit": {
              "type": "string"
            }
          }
        },
        "bcryptPepper": {
          "type": "object",
          "properties": {
            "existingSecret": {
              "type": "string"
            },
            "key": {
              "type": "string"
            }
          }
        },
        "verify": {
          "type": "boolean"
        },
        "extraArgs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "activeDeadlineSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "prepare": {
          "type": "object",
          "properties": {
            "resources": {
              "type": "object"
            }
          }
        },
        "resources": {
          "type": "object"
        }
      }
    },
    "backup": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "path": {
          "type": "string"
        },
        "keep": {
          "type": "integer",
          "minimum": 1
        },
        "intervalSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "retrySeconds": {
          "type": "integer",
          "minimum": 1
        },
        "startupWaitSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "initialDelaySeconds": {
          "type": "integer",
          "minimum": 0
        },
        "waitSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "s3": {
          "type": "object",
          "properties": {
            "endpoint": {
              "type": "string"
            },
            "bucket": {
              "type": "string"
            },
            "prefix": {
              "type": "string"
            },
            "existingSecret": {
              "type": "string"
            }
          }
        },
        "image": {
          "type": "object",
          "properties": {
            "repository": {
              "type": "string"
            },
            "tag": {
              "type": "string"
            }
          }
        },
        "resources": {
          "type": "object"
        },
        "metricsPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    }
  }
}
